        <mxCell id="e10" value="рубрика и срок" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10.5;endArrow=block;endFill=1;strokeColor=#7a7a7a;" edge="1" parent="1" source="assignments" target="subs"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="ingest" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10.5;endArrow=block;endFill=1;strokeColor=#7a7a7a;dashed=1;" edge="1" parent="1" source="pr" target="subs"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="снимок" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10.5;endArrow=block;endFill=1;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="rubfile" target="snapshot"><mxGeometry relative="1" as="geometry" /></mxCell>
