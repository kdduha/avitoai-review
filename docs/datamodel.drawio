        <mxCell id="e16" value="без цитат и уверенностей" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10.5;endArrow=block;endFill=1;strokeColor=#b85450;" edge="1" parent="1" source="draft" target="student"><mxGeometry relative="1" as="geometry" /></mxCell>
