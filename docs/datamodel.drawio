        <mxCell id="b4" value="4 · API — pydantic-схемы наружу: одна сдача в четырёх видах" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9a9a9a;verticalAlign=top;fontSize=14;fontStyle=1;dashed=1;align=left;spacingLeft=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="1520" height="190" as="geometry" /></mxCell>
        <mxCell id="b5" value="5 · Фронтенд — TypeScript" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9a9a9a;verticalAlign=top;fontSize=14;fontStyle=1;dashed=1;align=left;spacingLeft=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="1090" width="1520" height="150" as="geometry" /></mxCell>
        <mxCell id="rubfile" value="&lt;b&gt;backend/rubrics/*.json&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;Rubric: Scale · LatePolicy&lt;br&gt;Criterion[] · FormatCheck[]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="75" width="280" height="76" as="geometry" /></mxCell>
        <mxCell id="revfile" value="&lt;b&gt;backend/reviewers/*.md&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;карточка ревьюера:&lt;br&gt;темы, ёмкость в минутах&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="75" width="250" height="76" as="geometry" /></mxCell>
        <mxCell id="pr" value="&lt;b&gt;GitHub pull request&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;дифф, дерево на head,&lt;br&gt;история коммитов, дата PR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="75" width="280" height="76" as="geometry" /></mxCell>
