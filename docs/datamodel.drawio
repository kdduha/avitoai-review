        <mxCell id="b1" value="1 · Источники правды вне базы" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9a9a9a;verticalAlign=top;fontSize=14;fontStyle=1;dashed=1;align=left;spacingLeft=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1520" height="130" as="geometry" /></mxCell>
        <mxCell id="b2" value="2 · PostgreSQL — 9 таблиц, SQLAlchemy 2 async" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9a9a9a;verticalAlign=top;fontSize=14;fontStyle=1;dashed=1;align=left;spacingLeft=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="1520" height="360" as="geometry" /></mxCell>
