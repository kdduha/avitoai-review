        <mxCell id="streamrev" value="&lt;b&gt;stream_reviewers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;stream_id · reviewer_id&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="348" width="200" height="50" as="geometry" /></mxCell>
        <mxCell id="subs" value="&lt;b&gt;submissions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;origin_url · rubric_key · status&lt;br&gt;assignment_id · student_id · reviewer_id&lt;br&gt;submitted_at · deadline_at · approved_at&lt;br&gt;— — —  JSON-колонки  — — —&lt;br&gt;bundle · files · draft · detection&lt;br&gt;rubric_snapshot&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="240" width="330" height="172" as="geometry" /></mxCell>
        <mxCell id="revisions" value="&lt;b&gt;review_revisions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;submission_id&lt;br&gt;author_type · diff&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1160" y="245" width="200" height="56" as="geometry" /></mxCell>
        <mxCell id="chat" value="&lt;b&gt;chat_messages&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;submission_id · seq · role&lt;br&gt;tool_name · proposed_patch&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1160" y="340" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="bundle" value="&lt;b&gt;SubmissionBundle&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;→ bundle&lt;br&gt;Artifact[] · Revision[]&lt;br&gt;RepoContext · StudentRef&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="632" width="250" height="104" as="geometry" /></mxCell>
        <mxCell id="texts" value="&lt;b&gt;ArtifactText[]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;→ files&lt;br&gt;lines · line_numbers&lt;br&gt;partial · origin&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="632" width="210" height="104" as="geometry" /></mxCell>
        <mxCell id="draft" value="&lt;b&gt;ReviewDraft&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;→ draft&lt;br&gt;CriterionVerdict[] → Evidence[]&lt;br&gt;ReviewSummary · GateReport&lt;br&gt;score · passed · late_explanation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="632" width="300" height="104" as="geometry" /></mxCell>
        <mxCell id="detect" value="&lt;b&gt;DetectionReport&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;→ detection&lt;br&gt;SignalResult[] · Span[]&lt;br&gt;label · overall_score&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="632" width="220" height="104" as="geometry" /></mxCell>
        <mxCell id="snapshot" value="&lt;b&gt;Rubric&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;→ rubric_snapshot&lt;br&gt;замороженная копия рубрики&lt;br&gt;на момент разбора&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1170" y="632" width="250" height="104" as="geometry" /></mxCell>
        <mxCell id="detail" value="&lt;b&gt;SubmissionDetail&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;карточка ревьюера: bundle,&lt;br&gt;files, draft, detection, rubric&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="910" width="260" height="76" as="geometry" /></mxCell>
        <mxCell id="summary" value="&lt;b&gt;SubmissionSummary&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;строка очереди: статус, балл,&lt;br&gt;needs_human_attention&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="910" width="240" height="76" as="geometry" /></mxCell>
        <mxCell id="student" value="&lt;b&gt;StudentSubmission&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;усечённая: балл и отзыв&lt;br&gt;только у утверждённых&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="910" width="260" height="76" as="geometry" /></mxCell>
        <mxCell id="stats" value="&lt;b&gt;StreamStats · AssignmentStats&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;агрегаты по потоку: средний&lt;br&gt;балл, доля зачётов, просрочка&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="910" width="270" height="76" as="geometry" /></mxCell>
        <mxCell id="openapi" value="&lt;b&gt;OpenAPI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;/openapi.json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1230" y="910" width="190" height="76" as="geometry" /></mxCell>
        <mxCell id="dts" value="&lt;b&gt;src/lib/backend.d.ts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;генерируется из OpenAPI&lt;br&gt;(npm run gen:api), руками не пишется&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="1128" width="300" height="76" as="geometry" /></mxCell>
        <mxCell id="workspace" value="&lt;b&gt;Workspace&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;собирается в lib/workspace.ts из SubmissionDetail:&lt;br&gt;файлы с номерами строк, вердикты,&lt;br&gt;цитаты со смещениями в тексте&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="1128" width="380" height="76" as="geometry" /></mxCell>
        <mxCell id="screens" value="&lt;b&gt;Экраны&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;/review · /queue · /my-work&lt;br&gt;/streams · /admin&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="1128" width="250" height="76" as="geometry" /></mxCell>
        <mxCell id="n1" value="Рубрика — данные, а не код: завести курс = добавить JSON.&lt;br&gt;В базе рубрик нет, есть только их снимки на сдачах." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="980" y="88" width="560" height="60" as="geometry" /></mxCell>
        <mxCell id="n2" value="Пять JSON-колонок — не «мусорка»: это дословно те же pydantic-модели,&lt;br&gt;что отдают /review и /detect. Их состав — слоем ниже." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="760" y="428" width="560" height="50" as="geometry" /></mxCell>
        <mxCell id="n2b" value="Ревизии — журнал правок балла: что было,&lt;br&gt;что стало и кто автор — модель, человек&lt;br&gt;или человек по подсказке модели." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1160" y="420" width="290" height="70" as="geometry" /></mxCell>
        <mxCell id="n3" value="Балл считает код, а не модель: каждая Evidence сверяется с текстом файла,&lt;br&gt;сумму собирает агрегатор." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="70" y="748" width="700" height="50" as="geometry" /></mxCell>
        <mxCell id="n3b" value="Правка JSON рубрики задним числом не меняет&lt;br&gt;уже выставленные баллы." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1170" y="748" width="340" height="50" as="geometry" /></mxCell>
        <mxCell id="n4" value="Студенту не показывают черновик: ни цитат, ни уверенности модели, ни сигнала ГенИИ,&lt;br&gt;ни балла до утверждения ревьюером. Чужая сдача — 404, а не 403." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="630" y="992" width="800" height="50" as="geometry" /></mxCell>
        <mxCell id="n5" value="Зеркало серверной валидации рубрик живёт в lib/rubric.ts,&lt;br&gt;и есть тест, который ловит расхождение с ai/rubric.py." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1120" y="1140" width="430" height="60" as="geometry" /></mxCell>
