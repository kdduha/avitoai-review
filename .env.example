# Переменные для docker-compose (postgres, redis, backend, worker, frontend).
# Скопируйте в .env рядом с docker-compose.yml — сам файл уже под gitignore.
# Это НЕ backend/.env: тот читает `uv run uvicorn ...` в обход docker-compose,
# этот — сам `docker-compose.yml` (`x-backend-env`) для backend и worker разом,
# так что реран через Redis/arq видит того же провайдера, что и обычный запрос.
#
# Без .env всё поднимается и без единого ключа: AI_LLM__PROVIDER=fake проходит
# конвейер целиком, но черновик приходит с пометкой «оценить вручную».

# --- внешняя модель через OpenAI-совместимый эндпоинт ---
AI_LLM__PROVIDER=external
AI_LLM__BASE_URL=https://api.aitunnel.ru/v1
AI_LLM__MODEL=deepseek-v4-flash
AI_LLM__API_KEY=

# --- или полностью локальный контур (vLLM / Ollama на хосте) ---
# AI_LLM__PROVIDER=local
# AI_LLM__LOCAL_BASE_URL=http://host.docker.internal:11434/v1
# AI_LLM__LOCAL_MODEL=qwen2.5-7b-instruct

# Аварийный тумблер: наружу не ходим вовсе, даже если PROVIDER=external.
# AI_LLM__FORCE_LOCAL=true

# Матрица роутинга: своя модель под конкретную задачу (§8.3 architecture.md).
# JSON-строкой, например {"compile": "gpt-5.6-luna-pro"}. Пусто — всё на
# AI_LLM__MODEL.
# AI_LLM__TASK_MODELS=

# --- ingest ---
# Без токена — анонимный лимит GitHub API, 60 запросов/час на весь контейнер.
# INGEST_GITHUB__TOKEN=

# --- авторизация ---
# Подписывает выданные JWT — смените, если стенд смотрит наружу дальше localhost.
# AUTH_JWT_SECRET=dev-only-change-me-in-production-please
# Один пароль на все три сеяных аккаунта (student/reviewer/admin).
# AUTH_SEED_PASSWORD=avito2026

# --- логи ---
# LOG_LEVEL=INFO
