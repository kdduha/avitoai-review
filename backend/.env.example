# Скопируйте в .env и подставьте ключ. Файл .env под gitignore.
# Без .env приложение и демо работают на провайдере `fake`: весь путь
# проходится, модель не вызывается, ключи не нужны.

# --- внешняя модель через OpenAI-совместимый эндпоинт ---
AI_LLM__PROVIDER=external
AI_LLM__BASE_URL=https://api.aitunnel.ru/v1
AI_LLM__MODEL=deepseek-v4-flash
AI_LLM__API_KEY=

# --- или полностью локальный контур (vLLM / Ollama) ---
# AI_LLM__PROVIDER=local
# AI_LLM__LOCAL_BASE_URL=http://localhost:11434/v1
# AI_LLM__LOCAL_MODEL=qwen2.5-7b-instruct

# Аварийный тумблер: наружу не ходим вовсе, даже если провайдер внешний.
# AI_LLM__FORCE_LOCAL=true

# --- ingest ---
# INGEST_GITHUB__TOKEN=
